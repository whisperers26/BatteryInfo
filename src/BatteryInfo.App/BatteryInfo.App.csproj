<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BatteryInfo</AssemblyName>
    <RootNamespace>BatteryInfo.App</RootNamespace>
    <!-- Program.Main starts Velopack before WPF, so App.xaml is a plain page, not the generated entry point. -->
    <StartupObject>BatteryInfo.App.Program</StartupObject>
    <Version>0.0.0</Version>
    <!-- The exe's own icon: Start menu and desktop shortcuts, Settings > Apps and the installer show it. -->
    <ApplicationIcon>BatteryInfo.ico</ApplicationIcon>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for NotifyIcon; keep its namespaces out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Next to the exe as well: ShortcutIcons points the installer's shortcuts at it. -->
    <None Include="BatteryInfo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryInfo.Core\BatteryInfo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BatteryInfo.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
