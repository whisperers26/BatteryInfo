<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BatteryInfo</AssemblyName>
    <RootNamespace>BatteryInfo.App</RootNamespace>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for NotifyIcon; keep its namespaces out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryInfo.Core\BatteryInfo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BatteryInfo.Core.Tests" />
  </ItemGroup>

</Project>
