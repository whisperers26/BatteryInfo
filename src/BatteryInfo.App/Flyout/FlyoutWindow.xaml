<Window x:Class="BatteryInfo.App.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BatteryInfo.App.ViewModels"
        Title="BatteryInfo"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        d:DataContext="{d:DesignInstance Type=vm:FlyoutViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- A Windows 11 style on/off switch for a CheckBox. -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                            <Border x:Name="Focus" CornerRadius="12" Margin="-3" BorderThickness="2"
                                    BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" Visibility="Collapsed" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A borderless glyph button, like the ones in Windows 11 flyout footers. -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
            <StackPanel x:Name="Root" Margin="12,0,0,0">
                <StackPanel x:Name="Header" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="Bolt" Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,1,3,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,3,1"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="Percent" Text="{Binding PercentText}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <Grid x:Name="Bar" Width="56" Height="4" Margin="0,5,0,0" HorizontalAlignment="Right">
                    <Border CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                    <Border x:Name="Fill" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter TargetName="Root" Property="Margin" Value="0,0,14,0" />
                    <Setter TargetName="Header" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="Bar" Property="Width" Value="NaN" />
                    <Setter TargetName="Bar" Property="HorizontalAlignment" Value="Stretch" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLabel}" Value="False">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                    <Setter TargetName="Bolt" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:BatteryLevel.Low}">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:BatteryLevel.Charging}">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:BatteryLevel.Unknown}">
                    <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="Row" CornerRadius="6" Padding="10,8" Margin="0,1" BorderThickness="1"
                    Background="Transparent" BorderBrush="Transparent" Cursor="Hand"
                    ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.HelpText="{Binding StatusText}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <!-- One value sits right of the name; several (earbuds) get a line of their own below it. -->
                        <ItemsControl x:Name="Values" ItemsSource="{Binding Components}" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Grid.Column" Value="2" />
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiComponent}" Value="True">
                                            <Setter Property="Grid.Row" Value="1" />
                                            <Setter Property="Grid.Column" Value="1" />
                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                            <Setter Property="Margin" Value="0,8,0,0" />
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Values" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="8">
                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False" />
                <StackPanel x:Name="EmptyState" Margin="24,28">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No devices found yet" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4"
                               HorizontalAlignment="Center" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Logitech, ROG, Razer, Betop and HUAWEI FreeClip devices show up here once they are connected." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="16,6,10,10" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel>
                <Grid MinHeight="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UpdatedText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}"
                            ToolTip="Refresh now" AutomationProperties.Name="Refresh now">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </Grid>
                <Grid MinHeight="36" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Low-battery alert at" Style="{StaticResource SettingLabelStyle}" />
                    <ComboBox Grid.Column="1" MinWidth="90" VerticalAlignment="Center"
                              ItemsSource="{Binding ThresholdOptions}" SelectedItem="{Binding Threshold}"
                              AutomationProperties.Name="Low-battery alert threshold">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0} %}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid MinHeight="36" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Low-battery notifications" Style="{StaticResource SettingLabelStyle}" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                              IsChecked="{Binding NotificationsEnabled}" AutomationProperties.Name="Low-battery notifications" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
